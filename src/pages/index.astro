---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Prose from "../components/Prose.astro";

const home = await getEntry("site", "home");
const { Content: HomeContent } = await home.render();
const sections = await Promise.all(
  (await getCollection("overview"))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ entry, Content: (await entry.render()).Content })),
);
---

<Base title={home.data.title} description={home.data.description}>
  <header class="max-w-[68ch] motion-safe:animate-rise">
    <h1 class="font-display text-[clamp(2.75rem,6vw,5.25rem)] font-medium leading-[1.02] tracking-[-0.02em] text-ink">
      {home.data.title}
    </h1>
    <div class="mt-8">
      <Prose>
        <HomeContent />
      </Prose>
    </div>
  </header>

  <nav aria-label="Contents" class="mt-16 border-t border-rule pt-10">
    <h2 class="font-display text-[1.5rem] font-medium">Contents</h2>
    <ol class="mt-6 grid gap-x-12 gap-y-3 md:grid-cols-2">
      {
        sections.map(({ entry }) => (
          <li>
            <a
              href={`#${entry.slug}`}
              class="text-[1.02rem] text-ink no-underline hover:text-ts focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts"
            >
              {entry.data.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    sections.map(({ entry, Content }) => (
      <section id={entry.slug} class="mt-24 scroll-mt-10">
        <h2 class="border-t border-rule pt-12 font-display text-[2.4rem] font-medium leading-[1.1] tracking-[-0.01em] text-ink">
          {entry.data.title}
        </h2>
        <div class="mt-4">
          <Prose>
            <Content />
          </Prose>
        </div>
      </section>
    ))
  }
</Base>
