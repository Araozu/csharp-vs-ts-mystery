---
interface Props {
  leftLabel?: string;
  rightLabel?: string;
  mysteryLabel?: string;
}
const { leftLabel = "C#", rightLabel = "TypeScript", mysteryLabel = "Mystery (yours)" } = Astro.props;
---

<div class="compare">
  <div>
    <h3>{leftLabel}</h3>
    <slot name="left" />
  </div>
  <div>
    <h3>{rightLabel}</h3>
    <slot name="right" />
  </div>
  <div>
    <h3>{mysteryLabel}</h3>
    <slot name="mystery">
      <p><small><em>Blank — fill in your language.</em></small></p>
      <pre><code>// TODO: your language here</code></pre>
    </slot>
  </div>
</div>
