---
import Compare from "../components/Compare.astro";
---

<section id="control-flow">
  <h2>18. Conditionals, switches, loops</h2>
  <Compare>
    <div slot="left">
      <pre><code>string label = score switch
&#123;
  &gt;= 90 =&gt; "A",
  &gt;= 80 =&gt; "B",
  _ =&gt; "F"
&#125;;

switch (role)
&#123;
  case "admin": Grant(); break;
  case "editor" when canEdit: Grant(); break;
  default: Deny(); break;
&#125;

for (int i = 0; i &lt; n; i++) &#123; /* ... */ &#125;
foreach (var u in users) &#123; /* ... */ &#125;
while (more) &#123; /* ... */ &#125; &#125;</code></pre>
    </div>
    <div slot="right">
      <pre><code>const label =
  score &gt;= 90 ? "A" :
  score &gt;= 80 ? "B" : "F";

switch (role) &#123;
  case "admin": grant(); break;
  // no 'when' guard — use if inside
  default: deny(); break;
&#125;

// expression-style via object map:
const handlers: Record&lt;string, () =&gt; void&gt; = &#123; admin: grant, editor: grant &#125;;
(handlers[role] ?? deny)();

for (let i = 0; i &lt; n; i++) &#123; /* ... */ &#125;
for (const u of users) &#123; /* ... */ &#125; // like foreach
// for (const k in obj) — keys, avoid on arrays
while (more) &#123; /* ... */ &#125;</code></pre>
    </div>
  </Compare>
  <ul>
    <li>C# <code>foreach</code> = TS <code>for...of</code>. TS <code>for...in</code> iterates keys — almost never what you want for arrays.</li>
    <li>C# switch expressions return values exhaustively. TS switch is a statement — use ternary chains or lookup maps for expression style.</li>
  </ul>
</section>

<hr />

<section id="pattern-matching">
  <h2>19. Pattern matching &amp; narrowing</h2>
  <Compare>
    <div slot="left">
      <pre><code>object shape = new Circle(2);
double area = shape switch
&#123;
  Circle c =&gt; Math.PI * c.R * c.R,
  Rectangle &#123; W: var w, H: var h &#125; =&gt; w * h,
  null =&gt; 0,
  _ =&gt; throw new ArgumentException("unknown")
&#125;;

if (shape is Circle circle) Console.WriteLine(circle.R);

// list + relational + logical patterns (C# 9+)
bool ok = score is &gt;= 90 or &lt;= 10;
if (arr is [1, .., 5]) Console.WriteLine("starts 1 ends 5");</code></pre>
    </div>
    <div slot="right">
      <pre><code>type Shape =
  | &#123; kind: "circle"; r: number &#125;
  | &#123; kind: "rect"; w: number; h: number &#125;;
declare const shape: Shape;

const area =
  shape.kind === "circle" ? Math.PI * shape.r ** 2 :
  shape.kind === "rect"   ? shape.w * shape.h :
  (() =&gt; &#123; throw new Error("unknown"); &#125;)();

// guards: typeof / instanceof / in / predicates
function isCircle(s: Shape): s is Extract&lt;Shape, &#123; kind: "circle" &#125;&gt; &#123;
  return s.kind === "circle";
&#125;
if (isCircle(shape)) console.log(shape.r);

// exhaustiveness via never:
function assertNever(x: never): never &#123; throw new Error("unhandled"); &#125;</code></pre>
    </div>
  </Compare>
  <ul>
    <li>C# patterns match on runtime type. TS narrows via discriminant props (<code>kind</code>), <code>typeof</code>, <code>in</code>, and guard functions.</li>
    <li>Exhaustiveness: C# warns on non-exhaustive enum switches; TS checks via <code>never</code> in the default branch.</li>
  </ul>
  <h3>Destructuring</h3>
  <Compare>
    <div slot="left">
      <pre><code>var (code, msg) = (200, "ok");
var person = new Person("Ada", 36);
var (name, age) = person; // needs Deconstruct

// discard
var (_, onlyMsg) = (200, "ok");</code></pre>
    </div>
    <div slot="right">
      <pre><code>const [code, msg] = [200, "ok"] as const;
const person = &#123; name: "Ada", age: 36 &#125;;
const &#123; name, age &#125; = person;
const &#123; name: display = "n/a", ...rest &#125; = person;
const [first, ...others] = [1, 2, 3];
const [a = 0] = []; // defaults</code></pre>
    </div>
  </Compare>
</section>

