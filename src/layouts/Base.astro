---
import { getCollection } from "astro:content";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current } = Astro.props;
const topics = (await getCollection("topics")).sort((a, b) => a.data.order - b.data.order);
const fonts =
  "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..500&family=IBM+Plex+Mono:wght@400;500&display=swap";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
  </head>
  <body class="min-h-screen bg-paper font-body text-ink antialiased">
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-[88rem] items-center justify-between gap-6 px-6 py-4 lg:px-10">
        <a
          href="/"
          class="font-display text-[1.35rem] font-medium leading-none text-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ts"
        >
          Facing pages
        </a>
        <p class="hidden font-mono text-sm text-ink-soft md:block">C# ↔ TypeScript ↔ yours</p>
        <details class="relative">
          <summary
            class="cursor-pointer list-none font-display text-[1.05rem] font-medium text-ink [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ts"
          >
            All topics
          </summary>
          <nav
            aria-label="All topics"
            class="absolute right-0 z-10 mt-4 w-[min(46rem,calc(100vw-3rem))] border border-rule bg-sheet p-6 shadow-[0_18px_40px_-24px_rgb(27_36_51/0.35)]"
          >
            <ol class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
              {
                topics.map((t) => (
                  <li>
                    <a
                      href={`/${t.slug}/`}
                      aria-current={t.slug === current ? "page" : undefined}
                      class="flex gap-3 py-0.5 text-[0.98rem] text-ink no-underline hover:text-ts aria-[current=page]:font-semibold aria-[current=page]:text-ts focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts"
                    >
                      <span class="w-6 shrink-0 font-mono text-sm text-ink-soft tabular-nums">
                        {String(t.data.order).padStart(2, "0")}
                      </span>
                      <span>{t.data.title}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </details>
      </div>
    </header>
    <main class="mx-auto max-w-[100rem] px-6 pb-24 pt-14 lg:px-10">
      <slot />
    </main>
  </body>
</html>
